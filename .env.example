# Copy this file to .env.local and fill in real values (never commit .env.local).

# --- Supabase (Dashboard → Settings → API) ---
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Publishable key (sb_publishable_...) — safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here

# Secret key (sb_secret_...) — server-only, never expose to the browser.
SUPABASE_SECRET_KEY=your_sb_secret_key_here

# --- Admin ---
# The email of the admin account (the user you create in Supabase Auth for yourself).
# Only this email can open /admin.
ADMIN_EMAIL=your_email@example.com

# --- Her ---
# The email of her account. Only this email (and ADMIN_EMAIL) can see the site.
GF_EMAIL=your_gf_email@example.com
